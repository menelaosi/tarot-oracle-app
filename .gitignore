# Dependencies
node_modules/

# Environment secrets
.env
.env.*
!.env.example

# Build output
dist/
server/**/*.js
server/**/*.js.map
server/**/*.d.ts
server/**/*.d.ts.map
# ...except real source config files that happen to live in server/ and end in .js
!server/eslint.config.js

# macOS
.DS_Store

# Logs
*.log

# Editor — personal VSCode settings stay local; .editorconfig is the shared
# style source, and extensions.json is worth sharing.
.vscode/*
!.vscode/extensions.json